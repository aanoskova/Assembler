%macro MyMacrolab 5;
	mov AX, %1
	mov BX, %2
	mov CX, %3
	mov DX, %4
	CALL %5
%endmacro
;===[ Начало сегмента кода ]============================================
MYCODE: segment .code
org 100h	; Обязательная директива ТОЛЬКО для COM-файлов
START:
;---[ Точка старта ]---------------------------------------------------------------------

	;MyMacrolab 00h, BX,CX,DX, CharacterString
	;MyMacrolab 20h, BX,CX,DX, CharacterString
	;MyMacrolab 40h, BX,CX,DX, CharacterString
	MyMacrolab 20h, BX,CX,DX, CreateString
	MyMacrolab 20h, BX,CX,DX, FirstSymbolString

;---[ Стандартное завершение программы - НЕ СТИРАТЬ НИКОГДА !!! ]------------------------
	mov AX, 4C00h
	int 21h



;===[ Начало сегмента данных ]==========================================
	
CharacterString:
	mov SI, AX
	mov byte [SI], 00h
	RET

CreateString:
	mov SI, AX
	mov word [SI], 'Fi'
	mov word [SI+2], 'nd'
	mov word [SI+4], ' n'
	mov word [SI+6], 'o '
	mov word [SI+8], 'te'
	mov word [SI+10],'rm'
	mov byte [SI+12], 00h
	RET

FirstSymbolString:
	mov SI,AX
	mov DX, 0FFFh
	xor BX, BX

FindLoop:
	mov CL, [SI+BX+1]
	cmp CL, 00h
	je End1

	cmp CL, 'n'
	je Found

	inc BX
	jmp FindLoop
Found:
	mov DX, BX
	inc DX
End1:
	RET
	
